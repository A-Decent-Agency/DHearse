# DHearse service runtime only; this file does not configure Supporter minting.
DHEARSE_ENABLED=false
DHEARSE_PORT=8080
DHEARSE_HOST=127.0.0.1
DHEARSE_ALLOWED_ORIGINS=http://localhost:8080
DHEARSE_PRODUCT_NAME=DHearse
DHEARSE_NAMESPACE=dhearse

# Configure these before enabling the rehearsal worker. Use a dedicated 32-byte
# hex key and keep DHEARSE_NAMESPACE stable after the first checkpoint.
DHEARSE_OWNER_WALLET=
DHEARSE_ENGINEER_WALLETS=
DHEARSE_STORAGE_KEY=
DHEARSE_DISTINCT_STORAGE_KEYS=
PINATA_JWT=
DHEARSE_LIVEKIT_URL=
DHEARSE_LIVEKIT_API_KEY=
DHEARSE_LIVEKIT_API_SECRET=

# Optional host-app integration. Add an isEligibleHost(wallet) callback in
# server/index.js for dynamic booking or invitation eligibility.
